-- scripts/browser.pluto
-- key = "browser". Opens a URL in the default browser via xdg-open.

local exec = require("lib.exec")
local result = require("lib.result")

local M = {}

M.meta = {
    name = "Browser",
    description = "Open a URL in the default web browser.",
    actions = { "open" },
    keywords = {
        "browser", "web browser", "open the browser", "open a page",
        "open a website", "open a web page",
    },
    params = { url = "the URL to open" },
    timeout_ms = 5000,
    examples = {
        { action = "open", target = "https://example.com" },
    },
}

-- No URL in the spoken words ("open browser") -> open the default start page.
local DEFAULT_URL = "https://www.google.com"

function M.execute(cmd)
    if cmd.action ~= "open" then
        return result.error($"unknown browser action: {cmd.action}")
    end
    -- empty target -> the default start page; `??` handles the nil case.
    local url = (cmd.target ?? "") == "" ? DEFAULT_URL : cmd.target

    local ok, res = exec.run("xdg_open", url)
    if not ok then
        return result.error(res)
    end

    return result.ok($"opened {url}")
end

return M
