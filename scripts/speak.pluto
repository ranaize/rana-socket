-- scripts/speak.pluto
-- key = "speak". The text-to-speech sink used by the ask hop's "reply" action,
-- and directly addressable as a command.

local exec = require("lib.exec")
local result = require("lib.result")

local M = {}

M.meta = {
    name = "Speak",
    description = "Speak text aloud via espeak-ng.",
    actions = { "speak" },
    params = { text = "the text to speak" },
    timeout_ms = 10000,
    examples = {
        { action = "speak", target = "Hello world" },
    },
}

function M.execute(cmd)
    local text = cmd.target ?? ""
    if text == "" then
        return result.error("nothing to speak")
    end

    local ok, res = exec.run("espeak", text)
    if not ok then
        return result.error(res)
    end

    return result.ok($"spoke: {text}")
end

return M
