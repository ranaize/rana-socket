-- scripts/lights.pluto
-- key = "lights". Smart-home light control via the deployment's `lights` backend.

local exec = require("lib.exec")
local result = require("lib.result")
local verbs = require("lib.verbs")

local M = {}

M.meta = {
    name = "Lights",
    description = "Control smart lights (on/off/toggle/color).",
    actions = { "on", "off", "toggle", "color" },
    keywords = {
        "lights", "light", "turn on the lights", "turn off the lights",
        "set the lights", "turn the lights on", "turn the lights off",
    },
    params = {
        room  = "room/zone identifier (target)",
        color = "hex color when action=color",
    },
    timeout_ms = 5000,
    examples = {
        { action = "on",  target = "living_room" },
        { action = "off", target = "bedroom" },
    },
}

-- Routed with a bare KEY ("turn off the lights")? The verb is in the words, not
-- in cmd.action; room is unknown so it defaults to "all" (backend-wide toggle).
function M.execute(cmd)
    local action = cmd.action
    local room = cmd.target or ""
    if not action or action == "" then
        action = verbs.infer(room, {
            { verb = "off",   patterns = { "turn%-?off", "off the lights", "%f[%a]off%f[^%a]" } },
            { verb = "on",    patterns = { "turn%-?on", "%f[%a]on%f[^%a]", "^on " } },
            { verb = "color", patterns = { "color" } },
        }, "toggle")
        room = ""   -- room was the spoken phrase, not a zone id
    end
    if room == "" then room = "all" end

    local args = { action, room }
    if action == "color" then
        table.insert(args, cmd.params and cmd.params.color or "")
    end

    local ok, res = exec.run("lights", table.unpack(args))
    if not ok then
        return result.error(res)
    end

    return result.ok("lights " .. action .. " " .. room)
end

return M
